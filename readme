# 🧩 WasmContainer — [@duun/wasm-container](https://www.npmjs.com/package/@duun/wasm-container)

> A powerful JavaScript library that creates a **fully functional React development and bundling environment** running **100% in the browser**, powered by WebAssembly.

[![npm version](https://img.shields.io/npm/v/@duun/wasm-container.svg)](https://www.npmjs.com/package/@duun/wasm-container)
[![License: MIT](https://img.shields.io/badge/license-MIT-blue.svg)](LICENSE)
[![Build with Love](https://img.shields.io/badge/made%20with-%E2%9D%A4-red.svg)](#)

---

## 🚀 What is it?

**WasmContainer** allows you to spin up a complete React development environment **entirely in the browser**.  
You can install npm dependencies, bundle your code, and run everything — **without Node.js or any backend**.

Perfect for:

- 🧠 Online playgrounds  
- ⚙️ Prototyping & rapid experiments  
- 📘 Interactive documentation  
- 🎓 Teaching & workshops  

---

## ✨ Features

- ✅ Full React runtime in the browser (supports `react-router-dom`, `axios`, and more)  
- ⚡ Lightning-fast bundling via `esbuild-wasm`  
- 📦 Custom npm resolver with in-memory Virtual File System (VFS)  
- 🌐 100% client-side — no backend needed  
- 🧠 Perfect for live demos, documentation, and prototyping  

---

## 📦 Installation

```bash
npm install @duun/wasm-container
npm install esbuild-wasm@0.23.1
⚙️ Basic Usage (Next.js Example)
1️⃣ Copy required assets to public/
bash
Copiar código
cp ./node_modules/esbuild-wasm/esbuild.wasm ./public/esbuild.wasm
cp ./node_modules/@duun/wasm-container/assets/resolver.js ./public/resolver.js
2️⃣ Simple Example
jsx
Copiar código
'use client';

import { useEffect, useState, useRef } from 'react';
import { WasmContainer } from '@duun/wasm-container';

// Example React project to test the container
const projectFiles = {
  '/package.json': {
    file: { 
      contents: `{
        "name": "react-app",
        "dependencies": {
          "react": "latest",
          "react-dom": "latest"
        }
      }`
    }
  },
  '/src/index.jsx': {
    file: {
      contents: `
        import React from 'react';
        import { createRoot } from 'react-dom/client';

        function App() {
          const [count, setCount] = React.useState(0);

          return (
            <div style={{ padding: '1rem', fontFamily: 'sans-serif' }}>
              <h1>⚙️ WasmContainer in Action!</h1>
              <p>React app bundled and rendered fully in the browser.</p>
              <button onClick={() => setCount(c => c + 1)}>
                Clicks: {count}
              </button>
            </div>
          );
        }

        const container = document.getElementById('root');
        const root = createRoot(container);
        root.render(<App />);
      `
    }
  }
};

export default function WasmEditor() {
  const [container, setContainer] = useState(null);
  const [isLoading, setIsLoading] = useState(true);
  const [status, setStatus] = useState('Ready to run.');
  const iframeRef = useRef(null);
  const isInitialized = useRef(false);

  useEffect(() => {
    async function initialize() {
      if (isInitialized.current) return;
      isInitialized.current = true;

      try {
        setStatus('Initializing WASM environment...');

        const instance = await WasmContainer.boot({
          resolverJsUrl: '/resolver.js',
          esbuildWasmUrl: '/esbuild.wasm'
        });

        setContainer(instance);
        setStatus('Environment ready!');
      } catch (error) {
        console.error('Critical initialization error:', error);
        setStatus('Initialization failed. Check console for details.');
      } finally {
        setIsLoading(false);
      }
    }

    initialize();
  }, []);

  const runCode = async () => {
    if (!container) {
      alert('The container is not initialized yet!');
      return;
    }

    try {
      setStatus('Mounting files...');
      await container.mount(projectFiles);

      setStatus('Installing dependencies...');
      await container.install();

      setStatus('Bundling code with esbuild...');
      const bundledCode = await container.bundle('/src/index.jsx');

      setStatus('Rendering preview...');
      const html = `
        <!DOCTYPE html>
        <html>
          <head><title>Preview</title></head>
          <body>
            <div id="root"></div>
            <script type="module">${bundledCode}</script>
          </body>
        </html>
      `;

      const blob = new Blob([html], { type: 'text/html' });
      iframeRef.current.src = URL.createObjectURL(blob);
      setStatus('✅ Success! Preview loaded.');
    } catch (error) {
      console.error('❌ Execution error:', error);
      setStatus('Bundling failed. Check console for details.');
    }
  };

  if (isLoading) return <h1>{status} ✨</h1>;

  return (
    <div style={{ border: '1px solid #ddd', padding: '1rem', borderRadius: '8px' }}>
      <button onClick={runCode} disabled={!container}>
        Run Code
      </button>
      <p style={{ fontFamily: 'monospace', height: '20px' }}>Status: {status}</p>
      <hr />
      <iframe
        ref={iframeRef}
        title="Preview"
        style={{
          width: '100%',
          height: '500px',
          border: '1px solid #ccc',
          background: '#fff',
        }}
        sandbox="allow-scripts"
      />
    </div>
  );
}
⚠️ Important Notes
Use the exact version esbuild-wasm@0.23.1 to ensure compatibility.

Copy both resolver.js and esbuild.wasm into your public/ directory.

WasmContainer.boot() must reference the public URLs of those files.

Run this component only on the client side ('use client') for SSR frameworks like Next.js.

