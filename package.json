{
  "name": "@duun/wasm-container",
  "version": "0.1.14",
  "description": "Um ambiente de desenvolvimento e empacotamento React que roda 100% no navegador usando WebAssembly.",
  "author": "Duun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/duun/wasm-container.git"
  },
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/embed-wasm.js && rollup -c",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "esbuild-wasm": "^0.23.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^6.0.2",
    "rollup": "^4.18.0"
  },
  "keywords": [
    "react",
    "wasm",
    "esbuild",
    "bundler",
    "browser",
    "compiler",
    "vfs"
  ]
}
